// ==========================================
// SCREEN 1: BLUETOOTH CONNECTION SETUP
// ==========================================
class BluetoothSetupScreen extends StatefulWidget {
  const BluetoothSetupScreen({super.key});

  @override
  State<BluetoothSetupScreen> createState() => _BluetoothSetupScreenState();
}

class _BluetoothSetupScreenState extends State<BluetoothSetupScreen> {
  List<BluetoothDevice> devices = [];
  bool isLoading = true;
  String statusMessage = "Requesting Bluetooth Permissions...";

  @override
  void initState() {
    super.initState();
    _requestPermissionsAndInit();
  }

  // Called when the app starts, AND when the Refresh button is pressed
  Future<void> _requestPermissionsAndInit() async {
    setState(() {
      isLoading = true;
      statusMessage = "Checking permissions...";
    });

    Map<Permission, PermissionStatus> statuses = await [
      Permission.bluetooth,
      Permission.bluetoothScan,
      Permission.bluetoothConnect,
      Permission.location,
    ].request();

    if (statuses[Permission.bluetoothConnect] == PermissionStatus.granted ||
        statuses[Permission.bluetooth] == PermissionStatus.granted) {
      setState(() {
        statusMessage = "Scanning for MediMesh Hub...";
      });
      _getPairedDevices();
    } else {
      setState(() {
        isLoading = false;
        statusMessage = "Permissions Denied. App needs Bluetooth access.";
      });
    }
  }

  Future<void> _getPairedDevices() async {
    try {
      List<BluetoothDevice> pairedDevices =
      await FlutterBluetoothSerial.instance.getBondedDevices();

      // 🔥 FILTER LOGIC: Only show devices named "MediMesh_Hub"
      List<BluetoothDevice> filteredDevices = pairedDevices.where((device) {
        return device.name != null && device.name!.contains("MediMesh_Hub");
      }).toList();

      setState(() {
        devices = filteredDevices;
        isLoading = false;
      });
    } catch (e) {
      setState(() {
        isLoading = false;
        statusMessage = "Bluetooth is off.\nPlease turn it on and tap Refresh.";
      });
      debugPrint("Error getting devices: $e");
    }
  }

  void _connectToDevice(BluetoothDevice device) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => MonitoringScreen(serverDevice: device),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(
            'MediMesh',
            style: TextStyle(fontWeight: FontWeight.bold, letterSpacing: 1.2, color: Colors.white)
        ),
        centerTitle: true,
        elevation: 8,
        shadowColor: Colors.teal.withOpacity(0.5),
        flexibleSpace: Container(
          decoration: BoxDecoration(
            gradient: LinearGradient(
              colors: [Colors.teal.shade800, Colors.teal.shade500],
              begin: Alignment.topLeft,
              end: Alignment.bottomRight,
            ),
          ),
        ),
        actions: [
          // 🔥 REFRESH BUTTON
          IconButton(
            icon: const Icon(Icons.refresh_rounded, color: Colors.white, size: 28),
            tooltip: "Refresh Devices",
            onPressed: _requestPermissionsAndInit,
          ),
          const SizedBox(width: 8),
        ],
      ),
      body: isLoading
          ? Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const CircularProgressIndicator(color: Colors.teal),
            const SizedBox(height: 20),
            Text(
              statusMessage,
              style: TextStyle(color: Colors.teal.shade700, fontWeight: FontWeight.w500),
            ),
          ],
        ),
      )
          : devices.isEmpty
          ? _buildEmptyState()
          : _buildDeviceList(),
    );
  }

  Widget _buildEmptyState() {
    return Center(
      child: Padding(
        padding: const EdgeInsets.symmetric(horizontal: 32.0),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Container(
              padding: const EdgeInsets.all(24),
              decoration: BoxDecoration(
                  color: Colors.white,
                  shape: BoxShape.circle,
                  boxShadow: [
                    BoxShadow(color: Colors.grey.shade300, blurRadius: 15, spreadRadius: 5)
                  ]
              ),
              child: Icon(Icons.hub_outlined, size: 80, color: Colors.grey.shade400),
            ),
            const SizedBox(height: 30),
            Text(
              "Hub Not Found",
              style: TextStyle(fontSize: 22, color: Colors.grey.shade800, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 12),
            Text(
              statusMessage.contains("Bluetooth is off")
                  ? statusMessage
                  : "Ensure your MediMesh Gateway is powered on and paired in your phone's Bluetooth settings.",
              textAlign: TextAlign.center,
              style: TextStyle(color: Colors.grey.shade600, fontSize: 15, height: 1.5),
            ),
            const SizedBox(height: 30),
            ElevatedButton.icon(
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.teal,
                foregroundColor: Colors.white,
                padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 12),
                shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(30)),
              ),
              icon: const Icon(Icons.refresh),
              label: const Text("Scan Again", style: TextStyle(fontWeight: FontWeight.bold, fontSize: 16)),
              onPressed: _requestPermissionsAndInit,
            )
          ],
        ),
      ),
    );
  }

  Widget _buildDeviceList() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Padding(
          padding: const EdgeInsets.fromLTRB(20, 24, 20, 8),
          child: Text(
            "AVAILABLE GATEWAYS",
            style: TextStyle(fontSize: 13, fontWeight: FontWeight.bold, color: Colors.teal.shade700, letterSpacing: 1.5),
          ),
        ),
        Expanded(
          child: ListView.builder(
            padding: const EdgeInsets.symmetric(horizontal: 16),
            itemCount: devices.length,
            itemBuilder: (context, index) {
              final device = devices[index];
              return Card(
                elevation: 4,
                shadowColor: Colors.teal.withOpacity(0.1),
                margin: const EdgeInsets.only(bottom: 16),
                shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
                child: ListTile(
                  contentPadding: const EdgeInsets.symmetric(horizontal: 20, vertical: 12),
                  leading: Container(
                    padding: const EdgeInsets.all(10),
                    decoration: BoxDecoration(
                        color: Colors.teal.shade50,
                        borderRadius: BorderRadius.circular(12)
                    ),
                    child: Icon(Icons.router_rounded, color: Colors.teal.shade600, size: 28),
                  ),
                  title: Text(device.name ?? "Unknown Device",
                      style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 15)),
                  subtitle: Text("MAC: ${device.address}", style: TextStyle(fontSize: 10, color: Colors.grey.shade600)),
                  trailing: ElevatedButton(
                    style: ElevatedButton.styleFrom(
                      backgroundColor: Colors.teal.shade600,
                      foregroundColor: Colors.white,
                      elevation: 0,
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
                    ),
                    onPressed: () => _connectToDevice(device),
                    child: const Text('Connect', style: TextStyle(fontWeight: FontWeight.bold)),
                  ),
                ),
              );
            },
          ),
        ),
      ],
    );
  }
}

// ==========================================
// SCREEN 2: LIVE MONITORING & ALERTS
// ==========================================
class MonitoringScreen extends StatefulWidget {
  final BluetoothDevice serverDevice;
  const MonitoringScreen({super.key, required this.serverDevice});

  @override
  State<MonitoringScreen> createState() => _MonitoringScreenState();
}

class _MonitoringScreenState extends State<MonitoringScreen>
    with SingleTickerProviderStateMixin {
  BluetoothConnection? connection;
  bool isConnected = false;
  bool isConnecting = true;
  bool isEmergency = false;

  String alertLocation = "";
  String alertType = "";
  String dataBuffer = "";

  late AnimationController _pulseController;

  @override
  void initState() {
    super.initState();
    _pulseController = AnimationController(
      vsync: this,
      duration: const Duration(seconds: 2),
    )..repeat(reverse: true);

    _connect();
  }

  Future<void> _connect() async {
    try {
      connection = await BluetoothConnection.toAddress(widget.serverDevice.address);
      setState(() {
        isConnected = true;
        isConnecting = false;
      });

      _showSnackBar("Connected to System Hub", Colors.green.shade700);

      connection!.input!.listen(_onDataReceived).onDone(() {
        if (mounted) {
          setState(() {
            isConnected = false;
          });
          _showSnackBar("Connection Lost. Please check Gateway.", Colors.red.shade700);
        }
      });
    } catch (e) {
      setState(() {
        isConnecting = false;
      });
      _showSnackBar("Failed to connect to Gateway", Colors.red.shade700);
      debugPrint('Connection error: $e');
    }
  }

  void _onDataReceived(Uint8List data) {
    String incomingText = ascii.decode(data);
    dataBuffer += incomingText;

    // Check if we have reached the end of an alert block
    if (dataBuffer.contains("--------------------------")) {

      // 🔥 THE FIX: Find the LAST occurrence of the start marker
      // This guarantees we only read the newest alert, even if old ones are stuck in the buffer
      int startIndex = dataBuffer.lastIndexOf("=== EMERGENCY DETECTED ===");

      if (startIndex != -1) {
        // Extract only the freshest alert text
        String latestAlertText = dataBuffer.substring(startIndex);

        try {
          // Parse from the fresh text only
          alertLocation = latestAlertText.split("Location: ")[1].split("\n")[0].trim();
          alertType = latestAlertText.split("Type: ")[1].split("\n")[0].trim();

          setState(() {
            isEmergency = true;
          });
        } catch (e) {
          debugPrint("Parsing error: $e");
        }
      }

      // Completely flush the buffer after reading so it's fresh for the next one
      dataBuffer = "";
    }

    // Failsafe: Clear buffer if it gets absurdly large due to garbage data
    if (dataBuffer.length > 1500) dataBuffer = "";
  }

  // Note: You can now delete the old _parseAlertData() function completely,
  // as we moved its logic safely inside _onDataReceived.

  void _parseAlertData() {
    try {
      if (dataBuffer.contains("Location:")) {
        alertLocation = dataBuffer.split("Location: ")[1].split("\n")[0].trim();
      }
      if (dataBuffer.contains("Type:")) {
        alertType = dataBuffer.split("Type: ")[1].split("\n")[0].trim();
      }
    } catch (e) {
      alertLocation = "Unknown Location";
      alertType = "Unknown Event";
    }
  }

  void _resolveEmergency() {
    setState(() {
      isEmergency = false;
      alertLocation = "";
      alertType = "";
    });
  }

  void _showSnackBar(String message, Color color) {
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(message, style: const TextStyle(fontWeight: FontWeight.w600)),
        backgroundColor: color,
        behavior: SnackBarBehavior.floating,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
        margin: const EdgeInsets.all(16),
      ),
    );
  }

  @override
  void dispose() {
    _pulseController.dispose();
    connection?.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: isEmergency ? const Color(0xFFD32F2F) : const Color(0xFFF0F4F8),
      appBar: AppBar(
        title: Text(
          widget.serverDevice.name ?? "Gateway",
          style: const TextStyle(fontWeight: FontWeight.bold, letterSpacing: 1.2, color: Colors.white),
        ),
        centerTitle: true,
        elevation: isEmergency ? 0 : 8,
        shadowColor: isEmergency ? Colors.transparent : Colors.teal.withOpacity(0.5),
        iconTheme: const IconThemeData(color: Colors.white),
        flexibleSpace: Container(
          decoration: BoxDecoration(
            gradient: LinearGradient(
              colors: isEmergency
                  ? [Colors.red.shade900, Colors.red.shade700]
                  : [Colors.teal.shade800, Colors.teal.shade500],
              begin: Alignment.topLeft,
              end: Alignment.bottomRight,
            ),
          ),
        ),
      ),
      body: isConnecting
          ? Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              const CircularProgressIndicator(color: Colors.teal),
              const SizedBox(height: 20),
              Text(
                "Handshaking with Gateway...",
                style: TextStyle(color: Colors.teal.shade700, fontWeight: FontWeight.w600, fontSize: 16),
              ),
            ],
          ))
          : isEmergency
          ? _buildEmergencyUI()
          : _buildNormalUI(),
    );
  }

  Widget _buildNormalUI() {
    return Center(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Stack(
            alignment: Alignment.center,
            children: [
              FadeTransition(
                opacity: _pulseController,
                child: Container(
                  width: 220,
                  height: 220,
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    color: Colors.teal.withOpacity(0.15),
                  ),
                ),
              ),
              Container(
                width: 150,
                height: 150,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  color: Colors.white,
                  boxShadow: [
                    BoxShadow(
                        color: Colors.teal.withOpacity(0.2),
                        blurRadius: 25,
                        spreadRadius: 5,
                        offset: const Offset(0, 10)
                    )
                  ],
                ),
                child: Icon(
                  isConnected ? Icons.health_and_safety_rounded : Icons.wifi_off_rounded,
                  size: 70,
                  color: isConnected ? Colors.teal.shade500 : Colors.grey.shade400,
                ),
              ),
            ],
          ),
          const SizedBox(height: 50),
          Text(
            isConnected ? "System Armed" : "System Offline",
            style: TextStyle(
              fontSize: 32,
              fontWeight: FontWeight.w800,
              color: isConnected ? Colors.teal.shade800 : Colors.grey.shade600,
            ),
          ),
          const SizedBox(height: 12),
          Text(
            isConnected
                ? "Monitoring mesh network for anomalies"
                : "Check gateway connection and restart",
            style: TextStyle(fontSize: 16, color: Colors.grey.shade600, fontWeight: FontWeight.w500),
          ),
        ],
      ),
    );
  }

  Widget _buildEmergencyUI() {
    return Center(
      child: Padding(
        padding: const EdgeInsets.symmetric(horizontal: 24.0),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Container(
              padding: const EdgeInsets.all(20),
              decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  color: Colors.white.withOpacity(0.2)
              ),
              child: const Icon(Icons.warning_rounded, size: 100, color: Colors.white),
            ),
            const SizedBox(height: 24),
            const Text(
              "EMERGENCY",
              style: TextStyle(
                fontSize: 42,
                fontWeight: FontWeight.w900,
                color: Colors.white,
                letterSpacing: 3,
              ),
            ),
            const SizedBox(height: 40),
            Container(
              width: double.infinity,
              padding: const EdgeInsets.all(28),
              decoration: BoxDecoration(
                color: Colors.white,
                borderRadius: BorderRadius.circular(24),
                boxShadow: const [
                  BoxShadow(color: Colors.black26, blurRadius: 20, offset: Offset(0, 10))
                ],
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  _buildDetailRow(Icons.location_on_rounded, "LOCATION", alertLocation),
                  const Padding(
                    padding: EdgeInsets.symmetric(vertical: 20),
                    child: Divider(height: 1, thickness: 1.5),
                  ),
                  _buildDetailRow(Icons.local_hospital_rounded, "ALERT TYPE", alertType, isAlert: true),
                ],
              ),
            ),
            const SizedBox(height: 50),
            SizedBox(
              width: double.infinity,
              height: 65,
              child: ElevatedButton.icon(
                style: ElevatedButton.styleFrom(
                  backgroundColor: Colors.white,
                  foregroundColor: Colors.red.shade900,
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)),
                  elevation: 8,
                ),
                icon: const Icon(Icons.check_circle_outline, size: 28),
                label: const Text(
                  "MARK RESOLVED",
                  style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold, letterSpacing: 1.2),
                ),
                onPressed: _resolveEmergency,
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildDetailRow(IconData icon, String label, String value, {bool isAlert = false}) {
    return Row(
      children: [
        Container(
          padding: const EdgeInsets.all(12),
          decoration: BoxDecoration(
              color: isAlert ? Colors.red.shade50 : Colors.grey.shade100,
              borderRadius: BorderRadius.circular(12)
          ),
          child: Icon(icon, color: isAlert ? Colors.red.shade700 : Colors.grey.shade700, size: 28),
        ),
        const SizedBox(width: 20),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(label, style: TextStyle(color: Colors.grey.shade500, fontSize: 13, fontWeight: FontWeight.w700, letterSpacing: 1.2)),
              const SizedBox(height: 4),
              Text(
                value,
                style: TextStyle(
                  fontSize: 22,
                  fontWeight: FontWeight.w800,
                  color: isAlert ? Colors.red.shade700 : Colors.grey.shade900,
                ),
              ),
            ],
          ),
        ),
      ],
    );
  }
}
