

/*
 * SENDER NODE "A" (AI BRAIN)
 * Hardware: ESP32 + INMP441 I2S Microphone
 * Features: Real-time Audio AI Inference, UART TX to Node B
 */

#include <WiFi.h> // Included so we can turn the radio off
#include <medimesh_model_inferencing.h> // ⚠️ YOUR EDGE IMPULSE LIBRARY ⚠️
#include <driver/i2s.h>

// --- UART PINS (Talking to ESP32 "B") ---
#define RXD2 16
#define TXD2 17

// --- MICROPHONE (I2S) SETTINGS ---
#define I2S_WS 15
#define I2S_SD 32
#define I2S_SCK 14
#define I2S_PORT I2S_NUM_0

#define SAMPLE_RATE EI_CLASSIFIER_FREQUENCY 
const int sample_buffer_size = EI_CLASSIFIER_RAW_SAMPLE_COUNT; 
int16_t sampleBuffer[EI_CLASSIFIER_RAW_SAMPLE_COUNT];

// ==============================================================================
// I2S SETUP
// ==============================================================================
void i2s_init() {
  i2s_config_t i2s_config = {
    .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_RX),
    .sample_rate = SAMPLE_RATE,
    .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
    .channel_format = I2S_CHANNEL_FMT_ONLY_LEFT,
    .communication_format = i2s_comm_format_t(I2S_COMM_FORMAT_I2S | I2S_COMM_FORMAT_I2S_MSB),
    .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
    .dma_buf_count = 4,
    .dma_buf_len = 1024,
    .use_apll = false,
    .tx_desc_auto_clear = false,
    .fixed_mclk = 0
  };

  i2s_pin_config_t pin_config = {
    .bck_io_num = I2S_SCK,
    .ws_io_num = I2S_WS,
    .data_out_num = -1, 
    .data_in_num = I2S_SD
  };

  i2s_driver_install(I2S_PORT, &i2s_config, 0, NULL);
  i2s_set_pin(I2S_PORT, &pin_config);
}

// ==============================================================================
// AUDIO CAPTURE
// ==============================================================================
bool record_audio() {
  size_t bytesIn = 0;
  esp_err_t result = i2s_read(I2S_PORT, &sampleBuffer, sample_buffer_size * sizeof(int16_t), &bytesIn, portMAX_DELAY);
  return (result == ESP_OK && (bytesIn / sizeof(int16_t)) == sample_buffer_size);
}

int microphone_audio_signal_get_data(size_t offset, size_t length, float *out_ptr) {
    for (size_t i = 0; i < length; i++) {
        out_ptr[i] = (float)sampleBuffer[offset + i];
    }
    return 0;
}

// ==============================================================================
// SETUP
// ==============================================================================
void setup() {
  Serial.begin(115200); // For PC Debugging
  
  // Initialize UART communication to talk to Node B
  Serial2.begin(115200, SERIAL_8N1, RXD2, TXD2); 
  
  // Turn off Wi-Fi to save RAM and power
  WiFi.mode(WIFI_OFF); 

  Serial.println("Initializing AI Brain...");
  i2s_init();
  Serial.println("AI Ready. Listening...");
}

// ==============================================================================
// MAIN LOOP
// ==============================================================================
void loop() {
  if (record_audio()) {
    signal_t signal;
    signal.total_length = sample_buffer_size;
    signal.get_data = &microphone_audio_signal_get_data;

    ei_impulse_result_t result = { 0 };
    EI_IMPULSE_ERROR res = run_classifier(&signal, &result, false);

    if (res != EI_IMPULSE_OK) {
        Serial.printf("ERR: Failed to run classifier (%d)\n", res);
        return;
    }

    bool emergencyDetected = false;
    String emergencyType = "";

    // Check all labels
    for (uint16_t i = 0; i < EI_CLASSIFIER_LABEL_COUNT; i++) {
        String currentLabel = String(result.classification[i].label);
        float confidence = result.classification[i].value;
        
        // Print to PC for debugging
        Serial.printf("  %s: %.2f%%\n", currentLabel.c_str(), confidence * 100);
        
        // TRIGGER LOGIC: If confidence > 80% and it's NOT BackgroundNoise
        if (confidence > 0.80 && currentLabel != "BackgroundNoise") {
            emergencyDetected = true;
            emergencyType = currentLabel; 
        }
        else if(confidence>0.50&& currentLabel=="Thud")
        {
          emergencyDetected=true;
          emergencyType=currentLabel;
        }
    }

    // Act on the result
    if (emergencyDetected) {
        Serial.println("\n🚨 AI DETECTED: " + emergencyType + " 🚨");
        
        // Send the alert over the jumper wire to ESP32 "B"
        Serial2.println("ALERT:" + emergencyType); 
        
        // Wait to prevent spamming the serial line
        delay(2000); 
        
        // Clear buffer so we don't trigger twice on the same sound
        i2s_zero_dma_buffer(I2S_PORT);
    }
  }
}
